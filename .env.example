# Server Base (Protocol + Domain + Port)
VITE_BACKEND_URL=http://localhost:8080

# API V1 Base (Used by Axios)
VITE_API_V1_BASE=http://localhost:8080/api/v1

# OAuth2 Endpoints (Standard paths, not under /api/v1)
VITE_API_OAUTH2_KAKAO=http://localhost:8080/oauth2/authorization/kakao
VITE_API_OAUTH2_NAVER=http://localhost:8080/oauth2/authorization/naver