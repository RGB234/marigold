{
  "name": "marigold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run check:env -- development && vite",
    "prod": "npm run check:env -- prod && vite --mode prod",
    "build:dev": "npm run check:env -- development && vite build --mode development",
    "build:prod": "npm run check:env -- prod && vite build --mode prod",
    "build:analyze": "cross-env BUNDLE_ANALYZE=true npm run build:dev",
    "check:env": "node scripts/check-env.mjs",
    "preview": "npm run build:dev && wrangler dev",
    "check:validation-policy": "node scripts/sync-validation-policy.mjs --check",
    "sync:validation-policy": "node scripts/sync-validation-policy.mjs --write",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "deploy": "npm run build:prod && wrangler deploy"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.20.0",
    "pinia": "^3.0.3",
    "sockjs-client": "^1.6.1",
    "vue": "^3.2.13",
    "vue-router": "^4.6.3",
    "vuetify": "^3.10.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.59.1",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
