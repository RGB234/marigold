{
  "name": "marigold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "prod": "vite --mode prod",
    "build:dev": "vite build --mode dev",
    "build:prod": "vite build --mode prod",
    "preview": "npm run build:dev && wrangler dev",
    "check:validation-policy": "node scripts/check-validation-policy.mjs",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "deploy": "npm run build:prod && wrangler deploy"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.12.2",
    "js-cookie": "^3.0.5",
    "pinia": "^3.0.3",
    "sockjs-client": "^1.6.1",
    "vue": "^3.2.13",
    "vue-router": "^4.6.3",
    "vuetify": "^3.10.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.1",
    "@playwright/test": "^1.59.1",
    "@types/js-cookie": "^3.0.6",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/ui": "^4.1.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.2",
    "msw": "^2.13.0",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.1.3",
    "wrangler": "^4.96.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
